# Chép thành /opt/riverbank/.env.local trên EC2. Deploy không ghi đè file này. Không commit bản thật.
# Tài khoản đăng nhập giao diện DB tại https://<SITE_ADDRESS>/db
DB_UI_USER=riverbank
# Sinh bằng: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'mat-khau-cua-ban'
DB_UI_PASS_HASH=$2a$14$...
# Role chỉ đọc, tạo bằng api/db/readonly_role.sql
PGWEB_DATABASE_URL=postgresql://riverbank_ro:MAT_KHAU_RO@riverbank-db.cdcgq4mmivnf.ap-southeast-1.rds.amazonaws.com:5432/riverbank?sslmode=require
