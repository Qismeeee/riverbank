# Chép thành /opt/riverbank/.env.local trên EC2. Deploy không ghi đè file này. Không commit bản thật.
# Tài khoản đăng nhập giao diện DB tại https://<SITE_ADDRESS>/db
DB_UI_USER=riverbank
# Sinh bằng: docker run --rm caddy:2-alpine caddy hash-password --plaintext '<mật khẩu UI>'
DB_UI_PASS_HASH=
# Role chỉ đọc riverbank_ro, tạo bằng api/db/readonly_role.sql.
# Dạng: postgresql://riverbank_ro:<mật khẩu role>@<RDS endpoint>:5432/riverbank?sslmode=require
PGWEB_DATABASE_URL=
