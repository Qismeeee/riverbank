# Copy thành .env để chạy local. File .env không bao giờ commit.
RIVERBANK_ENV=local
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
OPENROUTER_API_KEY=sk-or-v1-...
DATABASE_URL=postgresql://riverbank:riverbank@localhost:5432/riverbank
S3_BUCKET=
ALLOWED_ORIGINS=http://localhost:3000
ADDLIVETAG_API_KEY=
# Luồng /v1 chỉ bật khi mode enabled.
RIVERBANK_WORKFLOW_MODE=enabled
RIVERBANK_WORKFLOW_STORAGE=memory
RIVERBANK_WORKFLOW_FEATURES=seller_book
# Danh bạ người dùng mặc định là api/data/users.json, đổi bằng RIVERBANK_USER_DIRECTORY.
ACCESS_PASSCODE=
RIVERBANK_WORKFLOW_RISK=lightgbm
# jev cần OPENROUTER_API_KEY. open bỏ qua gate, gọi CIC luôn.
RIVERBANK_WORKFLOW_CIC_GATE=jev
# profiles đọc api/data/cic_profiles.json, fixed luôn trả nhóm 1 dư nợ 0
RIVERBANK_WORKFLOW_CIC_SOURCE=profiles
# openai hoặc openrouter. Với openrouter, model có tiền tố nhà cung cấp, ví dụ openai/gpt-4.1-mini
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
LLM_CACHE_DIR=
# Thời gian chờ mặc định cho mỗi lần gọi LLM. Copilot mặc định 20 giây 1 lần thử lại.
# Đổi riêng từng việc bằng LLM_<VIỆC>_TIMEOUT_SECONDS và LLM_<VIỆC>_MAX_RETRIES, ví dụ LLM_COPILOT_ASK_TIMEOUT_SECONDS=20
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
# Ngưỡng tần suất theo người gọi, dạng số lần/giây, 0/60 là tắt. Đếm riêng từng tiến trình uvicorn
RIVERBANK_RATE_LIMIT_CASE_CREATE=30/3600
RIVERBANK_RATE_LIMIT_STATEMENT_UPLOAD=20/3600
RIVERBANK_RATE_LIMIT_COPILOT=20/60
RIVERBANK_SLOW_REQUEST_MS=5000
RIVERBANK_DB_POOL_MAX_SIZE=5
RIVERBANK_DB_POOL_TIMEOUT_SECONDS=10
# Đọc sao kê. off: chỉ CSV và PDF có lớp chữ. llm: thêm OCR cho PDF scan, ảnh và trang ảnh trong PDF
RIVERBANK_STATEMENT_OCR=off
STATEMENT_OCR_PROVIDER=openrouter
STATEMENT_OCR_MODEL=google/gemini-3.1-flash-lite
STATEMENT_OCR_MAX_PAGES=20
# none: không lưu file sao kê gốc. s3: lưu vào S3_BUCKET, cần quyền s3:PutObject
RIVERBANK_DOCUMENT_STORE=none
# Worker chạy job nền trong tiến trình API. Mặc định on khi RIVERBANK_ENV=prod
RIVERBANK_JOB_WORKER=off
RIVERBANK_JOB_MAX_ATTEMPTS=3
RIVERBANK_JOB_LEASE_SECONDS=600
# jev: regex lọc ứng viên rồi Jev quyết, cần OPENROUTER_API_KEY. pattern: chỉ regex
RIVERBANK_STATEMENT_CLASSIFIER=jev
RIVERBANK_STATEMENT_PAYOUT_PATTERN=shopee
# memory hoặc kafka. kafka cần broker, local chạy make kafka-up
RIVERBANK_MESSAGE_BUS=memory
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=riverbank-api
KAFKA_GROUP_ID=riverbank
# Broker có SASL: SASL_SSL và SCRAM-SHA-512 hoặc PLAIN. Prod đọc user, pass từ riverbank/kafka
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=
KAFKA_USERNAME=
KAFKA_PASSWORD=
# Đẩy case_events sang Kafka qua bảng event_outbox. on cần RIVERBANK_MESSAGE_BUS=kafka mới ra ngoài tiến trình
# Xem docs/Riverbank-case-events.md
RIVERBANK_EVENT_RELAY=off
RIVERBANK_CASE_EVENTS_TOPIC=riverbank.case-events
RIVERBANK_EVENT_RELAY_BATCH_SIZE=100
RIVERBANK_EVENT_RELAY_IDLE_SECONDS=1
RIVERBANK_EVENT_RELAY_RETRY_SECONDS=10
# memory hoặc valkey. valkey cần server, local chạy make valkey-up. Prod đọc user, pass từ riverbank/valkey
RIVERBANK_KV_STORE=memory
VALKEY_HOST=localhost
VALKEY_PORT=6379
VALKEY_DB=0
VALKEY_SSL=false
VALKEY_KEY_PREFIX=riverbank:
VALKEY_TIMEOUT_SECONDS=5
VALKEY_USERNAME=
VALKEY_PASSWORD=
# Chặn lưu lượng vào model (OpenAI, OpenRouter, Jev): số lượt song song, lượt/phút, cầu dao khi nhà cung cấp lỗi.
# memory đếm riêng từng tiến trình, valkey dùng chung. Xem docs/Riverbank-model-gateway.md
RIVERBANK_MODEL_GATE=on
RIVERBANK_MODEL_GATE_STORE=memory
RIVERBANK_MODEL_GATE_OPENAI_CONCURRENCY=8
RIVERBANK_MODEL_GATE_OPENAI_PER_MINUTE=120
RIVERBANK_MODEL_GATE_OPENROUTER_CONCURRENCY=8
RIVERBANK_MODEL_GATE_OPENROUTER_PER_MINUTE=120
RIVERBANK_MODEL_GATE_JEV_CONCURRENCY=8
RIVERBANK_MODEL_GATE_JEV_PER_MINUTE=120
RIVERBANK_MODEL_GATE_BREAKER_FAILURES=5
RIVERBANK_MODEL_GATE_BREAKER_WINDOW_SECONDS=60
RIVERBANK_MODEL_GATE_BREAKER_OPEN_SECONDS=30
RIVERBANK_MODEL_GATE_WAIT_SECONDS=2
RIVERBANK_MODEL_GATE_LEASE_SECONDS=120
