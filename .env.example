# Copy thành .env để chạy local. File .env không bao giờ commit.
RIVERBANK_ENV=local
RIVERBANK_WORKFLOW_MODE=demo
RIVERBANK_WORKFLOW_AUTH=local_headers
RIVERBANK_WORKFLOW_STORAGE=memory
RIVERBANK_WORKFLOW_FEATURES=demo
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
OPENROUTER_API_KEY=sk-or-v1-...
DATABASE_URL=postgresql://riverbank:riverbank@localhost:5432/riverbank
S3_BUCKET=
ALLOWED_ORIGINS=http://localhost:3000
ADDLIVETAG_API_KEY=
