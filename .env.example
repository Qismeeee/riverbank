# Copy thành .env để chạy local. File .env không bao giờ commit.
RIVERBANK_ENV=local
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
OPENROUTER_API_KEY=sk-or-v1-...
DATABASE_URL=postgresql://riverbank:riverbank@localhost:5432/riverbank
S3_BUCKET=
ALLOWED_ORIGINS=http://localhost:3000
ADDLIVETAG_API_KEY=
# Luồng /v1 chỉ bật khi RIVERBANK_ENV=local và mode demo.
RIVERBANK_WORKFLOW_MODE=demo
RIVERBANK_WORKFLOW_STORAGE=memory
RIVERBANK_WORKFLOW_FEATURES=demo
RIVERBANK_WORKFLOW_RISK=lightgbm
# jev cần OPENROUTER_API_KEY. open bỏ qua gate, gọi CIC luôn.
RIVERBANK_WORKFLOW_CIC_GATE=jev
# template hoặc llm. llm vẫn rơi về template khi model lỗi hoặc viết sai số
RIVERBANK_MEMO_WRITER=template
# openai hoặc openrouter. Với openrouter, model có tiền tố nhà cung cấp, ví dụ openai/gpt-4.1-mini
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
LLM_CACHE_DIR=
